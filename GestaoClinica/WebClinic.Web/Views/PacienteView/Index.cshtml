@{
    ViewData["Title"] = "Gerenciamento de Pacientes";
}

<header class="pb-3 mb-4 border-bottom d-flex justify-content-between align-items-center">
    <h1 class="display-5">Gerenciamento de Pacientes</h1>
    <button id="btn-add-new" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#paciente-modal">
        <i class="bi bi-plus-circle-fill me-2"></i>Adicionar Novo Paciente
    </button>
</header>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover" id="paciente-tabela">
                <thead class="table-light">
                    <tr>
                        <th>Nome Completo</th>
                        <th>CPF</th>
                        <th>Telefone</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @* O conteúdo da tabela será preenchido via JavaScript *@
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="paciente-modal" tabindex="-1" aria-labelledby="modal-titulo" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal-titulo">Adicionar Paciente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="paciente-form">
                    <input type="hidden" id="paciente-id" name="PacienteId" />

                    <div class="mb-3">
                        <label for="nome-completo" class="form-label">Nome Completo</label>
                        <input type="text" class="form-control" id="nome-completo" name="NomeCompleto" required>
                    </div>
                    <div class="mb-3">
                        <label for="cpf" class="form-label">CPF</label>
                        <input type="text" class="form-control" id="cpf" name="CPF" required>
                    </div>
                    <div class="mb-3">
                        <label for="data-nascimento" class="form-label">Data de Nascimento</label>
                        <input type="date" class="form-control" id="data-nascimento" name="DataNascimento" required>
                    </div>
                    <div class="mb-3">
                        <label for="telefone-contato" class="form-label">Telefone</label>
                        <input type="tel" class="form-control" id="telefone-contato" name="TelefoneContato" required>
                    </div>
                    <div class="mb-3">
                        <label for="email" class="form-label">Email (Opcional)</label>
                        <input type="email" class="form-control" id="email" name="Email">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary" form="paciente-form">Salvar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>
        $(document).ready(function () {

            // CORREÇÃO 2: Definindo a URL completa da API
            const apiUrl = 'https://localhost:7288/api/pacientes';

            var modalElement = document.getElementById('paciente-modal');
            var modal = new bootstrap.Modal(modalElement);
            var form = $('#paciente-form');

            // --- FUNÇÃO PARA CARREGAR PACIENTES NA TABELA ---
            function carregarPacientes() {
                $.ajax({
                    url: apiUrl,
                    type: 'GET',
                    success: function (data) {
                        var tabelaBody = $('#paciente-tabela tbody');
                        tabelaBody.empty(); // Limpa a tabela antes de preencher
                        data.forEach(function (paciente) {
                            tabelaBody.append(`
                                <tr data-paciente-id="${paciente.pacienteId}">
                                    <td>${paciente.nomeCompleto}</td>
                                    <td>${paciente.cpf}</td>
                                    <td>${paciente.telefoneContato}</td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-secondary me-1 btn-editar" data-id="${paciente.pacienteId}" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger btn-excluir" data-id="${paciente.pacienteId}" data-name="${paciente.nomeCompleto}" title="Excluir">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            `);
                        });
                    },
                    error: function() {
                        alert('Erro ao carregar a lista de pacientes. Verifique se a API está rodando.');
                    }
                });
            }

            // Carrega os pacientes quando a página é aberta
            carregarPacientes();

            // --- LÓGICA DO MODAL E FORMULÁRIO ---

            $('#btn-add-new').on('click', function () {
                form.trigger('reset');
                $('#paciente-id').val('');
                $('#modal-titulo').text('Adicionar Novo Paciente');
            });

            $('#paciente-tabela').on('click', '.btn-editar', function () {
                var pacienteId = $(this).data('id');

                $.ajax({
                    url: apiUrl + '/' + pacienteId, // Usa a URL base da API
                    type: 'GET',
                    success: function (data) {
                        $('#paciente-id').val(data.pacienteId);
                        $('#nome-completo').val(data.nomeCompleto);
                        $('#cpf').val(data.cpf);
                        $('#data-nascimento').val(data.dataNascimento.split('T')[0]);
                        $('#telefone-contato').val(data.telefoneContato);
                        $('#email').val(data.email);

                        $('#modal-titulo').text('Editar Paciente');
                        modal.show();
                    },
                    error: function () {
                        alert('Erro ao carregar dados do paciente para edição.');
                    }
                });
            });

            form.on('submit', function (event) {
                event.preventDefault();

                var pacienteId = $('#paciente-id').val();
                var isEditing = pacienteId !== '' && pacienteId > 0;

                var url = isEditing ? apiUrl + '/' + pacienteId : apiUrl;
                var type = isEditing ? 'PUT' : 'POST';

                // No C# as propriedades são PascalCase, mas o ASP.NET Core consegue mapear de camelCase (padrão do JS)
                var formData = {
                    pacienteId: pacienteId || 0,
                    nomeCompleto: $('#nome-completo').val(),
                    cpf: $('#cpf').val(),
                    dataNascimento: $('#data-nascimento').val(),
                    telefoneContato: $('#telefone-contato').val(),
                    email: $('#email').val()
                };

                $.ajax({
                    url: url,
                    type: type,
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function () {
                        alert('Paciente salvo com sucesso!');
                        modal.hide();
                        carregarPacientes(); // Atualiza a tabela sem recarregar a página
                    },
                    error: function (xhr) {
                        alert('Erro ao salvar paciente: ' + xhr.responseText);
                    }
                });
            });

            $('#paciente-tabela').on('click', '.btn-excluir', function () {
                var pacienteId = $(this).data('id');
                var pacienteName = $(this).data('name');

                if (confirm('Tem certeza que deseja excluir o paciente "' + pacienteName + '"?')) {
                    $.ajax({
                        url: apiUrl + '/' + pacienteId,
                        type: 'DELETE',
                        success: function () {
                            alert('Paciente excluído com sucesso!');
                            carregarPacientes(); // Atualiza a tabela
                        },
                        error: function () {
                            alert('Erro ao excluir paciente.');
                        }
                    });
                }
            });
        });
    </script>
}