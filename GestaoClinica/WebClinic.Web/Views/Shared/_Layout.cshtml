<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebClinic System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="sidebar d-flex flex-column flex-shrink-0 p-3 text-white bg-dark">
        <a asp-controller="Home" asp-action="Dashboard" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
            <i class="bi bi-heart-pulse-fill me-2"></i>
            <span class="fs-4">WebClinic System</span>
        </a>
        <hr>

<ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
        <a class="nav-link text-white" asp-controller="Home" asp-action="Dashboard">
            <i class="bi bi-grid-fill me-2"></i> Dashboard
        </a>
    </li>
    <li>
         <a class="nav-link text-white" asp-controller="Agenda" asp-action="Index">
            <i class="bi bi-calendar-week-fill me-2"></i> Agenda
        </a>
    </li>
    <li>
        <a class="nav-link text-white" asp-controller="PacienteView" asp-action="Index">
            <i class="bi bi-person-fill me-2"></i> Pacientes
        </a>
    </li>
    <li>
        <a class="nav-link text-white" asp-controller="Profissional" asp-action="Index">
            <i class="bi bi-file-earmark-medical-fill me-2"></i> Profissionais
        </a>
    </li>
    <li>
        <a class="nav-link text-white" asp-controller="Prontuario" asp-action="Index">
            <i class="bi bi-file-earmark-text-fill me-2"></i> Prontuário
        </a>
    </li>

    <li>
        <a class="nav-link text-white" asp-controller="Relatorio" asp-action="Index">
            <i class="bi bi-bar-chart-fill me-2"></i> Relatórios
        </a>


<li>
    <a class="nav-link text-white" asp-controller="Usuario" asp-action="Index">
        <i class="bi bi-people-fill me-2"></i> Usuários
    </a>
</li>
</ul>


    </li>
</ul>
        <hr>
        <div>

        <a class="d-flex align-items-center text-white text-decoration-none mb-2" asp-controller="Perfil" asp-action="Index">
        <i class="bi bi-person-circle me-2"></i> Meu Perfil
    </a>

            <a asp-controller="Login" asp-action="Index" class="d-flex align-items-center text-white text-decoration-none">
                <i class="bi bi-box-arrow-right me-2"></i>
                <strong>Sair</strong>
            </a>
        </div>
    </nav>

    <div class="main-content">
        <main role="main" class="pb-3">
            @RenderBody() </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>